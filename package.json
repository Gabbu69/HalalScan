{
  "name": "halalscan",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "backend": "python -m backend.app",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "tsc --noEmit",
    "evaluate": "tsx test_ml.ts",
    "test:ml": "tsx test_ml.ts",
    "test:backend": "python -m pytest backend",
    "test:vercel-api": "tsx test_vercel_api.ts",
    "test:badges": "playwright test --grep \"result labels\"",
    "test:api": "node test_local_api.js",
    "test:gemini": "node test_gemini.js",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm test && npm run test:backend && npm run test:vercel-api && npm run evaluate && npm run build"
  },
  "dependencies": {
    "@fontsource/amiri": "^5.3.0",
